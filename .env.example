# Cliente (Vite)
VITE_USE_GROQ_VISION=false
VITE_USE_LISTA_NOMINAL=false
VITE_LISTA_NOMINAL_ENFORCE=false
VITE_GROQ_API_KEY=
VITE_GOOGLE_VISION_API_KEY=
VITE_EMAIL_API_KEY=
VITE_EMAIL_API_URL=

# Aviso de Privacidad (LFPDPPP) — datos del Responsable visibles en la App
VITE_PRIVACY_ORG_NAME=
VITE_PRIVACY_ORG_ADDRESS=
VITE_PRIVACY_ORG_EMAIL=
VITE_PRIVACY_ORG_PHONE=
VITE_PRIVACY_ORG_WEBSITE=
VITE_PRIVACY_UPDATED_AT=7 de septiembre de 2026

# Server / Vercel / spikes (SSD — nunca prefijo VITE_)
# DATOS_NONSTOP_API_KEY: configurar SOLO en servidor (Vercel env / .env.local).
# Nunca exponerla al browser ni con prefijo VITE_.
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.6-27b
DATOS_NONSTOP_API_KEY=
DATOS_NONSTOP_BASE_URL=https://api.datosnonstop.com
LISTA_NOMINAL_TIMEOUT_MS=20000
