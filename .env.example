# =============================================================================
# MC / movimiento — variables de entorno (mínimo operativo)
# =============================================================================
# Regla SSD: secretos de cifrado, SA y APIs de pago → SIN prefijo VITE_.
# Vercel Production: solo lo marcado [OBLIGATORIO] para demo campo+Admin.
# =============================================================================

# -----------------------------------------------------------------------------
# [OBLIGATORIO] Persistencia cifrada + Admin (APO-FIELD-PERSIST / D.2b)
# -----------------------------------------------------------------------------
FIRESTORE_BACKEND=firestore
FIREBASE_PROJECT_ID=movimiento-15317
FIREBASE_SERVICE_ACCOUNT_JSON=
CLOUD_KEK_SECRET=
CLOUD_BLIND_SECRET=
ADMIN_LIST_SECRET=
ADMIN_DEFAULT_ORG_ID=org_default
VITE_SYNC_ORG_ID=org_default
VITE_USE_ENCRYPTED_AFFILIATES_ADMIN=true
VITE_ADMIN_LIST_BEARER=

# -----------------------------------------------------------------------------
# [OBLIGATORIO] OCR Vision (servidor — nunca en el browser)
# -----------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
VITE_USE_GROQ_VISION=true

# -----------------------------------------------------------------------------
# [OBLIGATORIO] Firebase cliente (Auth / app; apiKey es pública por diseño)
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# [OPCIONAL] Aviso de Privacidad (si faltan, la UI usa placeholders)
# -----------------------------------------------------------------------------
VITE_PRIVACY_ORG_NAME=
VITE_PRIVACY_ORG_ADDRESS=
VITE_PRIVACY_ORG_EMAIL=
VITE_PRIVACY_ORG_PHONE=
VITE_PRIVACY_ORG_WEBSITE=
VITE_PRIVACY_UPDATED_AT=7 de septiembre de 2026

# -----------------------------------------------------------------------------
# [OPCIONAL] Email de bienvenida
# -----------------------------------------------------------------------------
VITE_EMAIL_API_KEY=
VITE_EMAIL_API_URL=

# -----------------------------------------------------------------------------
# [OPCIONAL] Lista Nominal (OFF por defecto). Solo si VITE_USE_LISTA_NOMINAL=true
# -----------------------------------------------------------------------------
VITE_USE_LISTA_NOMINAL=false
VITE_LISTA_NOMINAL_ENFORCE=false
DATOS_NONSTOP_API_KEY=
DATOS_NONSTOP_BASE_URL=https://api.datosnonstop.com
LISTA_NOMINAL_TIMEOUT_MS=20000

# -----------------------------------------------------------------------------
# [OPCIONAL] Cifrado local IndexedDB (campo). Default OFF.
# -----------------------------------------------------------------------------
VITE_USE_FIELD_ENCRYPTION=false

# -----------------------------------------------------------------------------
# [NO USAR EN VERCEL] — residual / riesgo SSD / local-only
# -----------------------------------------------------------------------------
# VITE_GROQ_API_KEY=          # ❌ filtración; usar solo GROQ_API_KEY en server
# VITE_GOOGLE_VISION_API_KEY= # legado
# VITE_GEMINI_API_KEY=        # legado
# GOOGLE_APPLICATION_CREDENTIALS=  # solo local; en Vercel usa FIREBASE_SERVICE_ACCOUNT_JSON
